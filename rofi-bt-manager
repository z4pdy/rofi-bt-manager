#!/usr/bin/env bash

rofi_command="rofi -dmenu $@ -p Bluetooth"

readonly OPTION_POWER="Power"
readonly OPTION_SCAN="Scan"
readonly OPTION_PAIRABLE="Pairable"
readonly OPTION_DISCOVERABLE="Discoverable"

get_available_devices() {
    mapfile -t devices < <(bluetoothctl devices| cut -d' ' -f3-)
}

get_property_state_string() {
    local property="$1"
    local expected_string

    case "$property" in
        "$OPTION_POWER")
            expected_string="PowerState: on"
            ;;
        "$OPTION_SCAN")
            expected_string="Discovering: yes"
            ;;
        "$OPTION_PAIRABLE")
            expected_string="Pairable: yes"
            ;;
        "$OPTION_DISCOVERABLE")
            expected_string="Discoverable: yes"
            ;;
        *)
            return 1
            ;;
    esac

    if bluetoothctl show | grep -q "$expected_string"; then
        echo "$property: on"
    else
        echo "$property: off"
    fi
}

rofi_options=()

power_state=$(get_property_state_string "$OPTION_POWER")
if [[ "$power_state" == "$OPTION_POWER: on" ]]; then
    devices=()
    get_available_devices devices
    if (( ${#devices[@]} > 0 )); then
        devices+=("======================")
    fi
    rofi_options+=("${devices[@]}")

    rofi_options+=("$power_state")

    rofi_options+=(
        "$(get_property_state_string "$OPTION_SCAN")"
        "$(get_property_state_string "$OPTION_PAIRABLE")"
        "$(get_property_state_string "$OPTION_DISCOVERABLE")"
    )
else
    rofi_options+=("$power_state")
fi

choice=$(printf '%s\n' "${rofi_options[@]}" | ${rofi_command})

case "$choice" in
    "$OPTION_POWER: on")
        bluetoothctl power off
        ;;
    "$OPTION_POWER: off")
        bluetoothctl power on
        ;;
    "$OPTION_SCAN: off")
        bluetoothctl --timeout 5 scan on
        ;;
    "$OPTION_PAIRABLE: on")
        bluetoothctl pairable off
        ;;
    "$OPTION_PAIRABLE: off")
        bluetoothctl pairable on
        ;;
    "$OPTION_DISCOVERABLE: on")
        bluetoothctl discoverable off
        echo "Discoverable -> off"
        ;;
    "$OPTION_DISCOVERABLE: off")
        bluetoothctl discoverable on
        ;;
    *)
        exit 0
        ;;
esac
